name "berkshelf-no-depselector"

license "Apache-2.0"
license_file "https://raw.githubusercontent.com/berkshelf/berkshelf/main/LICENSE"
skip_transitive_dependency_licensing true

dependency "nokogiri"
dependency "archive-tar-minitar"

build do
  env = with_standard_compiler_flags(with_embedded_path)

  gem "install archive-tar-minitar --no-document", env: env
  gem "install berkshelf --no-document", env: env

  block "overwrite_berks_binstubs_for_minitar" do
    # Use the Ruby interpreter from the embedded install!
    wrapper = <<~EOS
      #!#{install_dir}/embedded/bin/ruby
      require 'archive/tar/minitar'
      require 'rubygems'

      spec = Gem.loaded_specs['berkshelf'] || Gem::Specification.find_all_by_name('berkshelf').last
      abort("Could not find berkshelf gem!") unless spec

      berks_bin = File.join(spec.full_gem_path, 'bin/berks')
      load berks_bin
    EOS

    %w[bin/berks embedded/bin/berks].each do |binstub|
      binstub_path = File.join(install_dir, binstub)
      File.write(binstub_path, wrapper)
      FileUtils.chmod(0o755, binstub_path)
    end
  end
end